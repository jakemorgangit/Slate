<Window x:Class="Slate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:pages="clr-namespace:Slate.Components"
        xmlns:local="clr-namespace:Slate.Services"
        Title="Slate"
        Icon="appicon.ico"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116">
    <Grid>
        <local:EmbeddedBlazorWebView x:Name="BlazorView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type pages:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </local:EmbeddedBlazorWebView>
    </Grid>
</Window>
