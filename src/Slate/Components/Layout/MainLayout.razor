@inherits LayoutComponentBase
@implements IDisposable

@using Slate.Services

@inject AppState State
@inject UpdateChecker Updates
@inject SelfUpdater Updater
@inject SettingsStore Settings
@inject PlannerService Planner
@inject ToastService Toasts
@inject IJSRuntime Js
@inject NavigationManager Nav

@* Inert while an update hands over, so a field that had focus cannot take a keypress either. *@
<div class="app-shell @(Updates.Available is not null ? "has-notice" : "")" inert="@IsInstalling">

    @* Only present when GitHub has something newer than this build. *@
    @if (Updates.Available is { } release)
    {
        <div class="update-bar">
            <span class="glyph">↑</span>
            @if (Updater.IsBusy)
            {
                <span>@UpdateStatus(release)</span>
                @if (Updater.Phase == UpdatePhase.Downloading)
                {
                    <span class="update-progress" role="progressbar" aria-valuenow="@Updater.Percent" aria-valuemin="0" aria-valuemax="100">
                        <span style="width: @(Updater.Percent)%"></span>
                    </span>
                }
                <span class="topbar-spacer"></span>
                @if (Updater.CanCancel)
                {
                    <button class="btn btn-sm" title="Stop the download and stay on @AppInfo.Version" @onclick="Updater.Cancel">Cancel</button>
                }
            }
            else
            {
                <span>
                    <strong>Slate @release.Version</strong> is available — you are on @AppInfo.Version.
                </span>
                @if (Updater.CanInstall(release))
                {
                    <button class="btn btn-sm btn-primary"
                            title="Download @release.Version, check it, and restart into it. Settings and the plan carry over."
                            @onclick="() => InstallUpdateAsync(release)">
                        Install and restart
                    </button>
                }
                <a href="@release.Url" @onclick="OpenReleaseAsync" @onclick:preventDefault="true">
                    View the release ↗
                </a>
                <span class="topbar-spacer"></span>
                <button class="dismiss" title="Dismiss until next launch" @onclick="Updates.Dismiss">✕</button>
            }
        </div>
    }

    <header class="topbar">
        <div class="brand">
            <span class="brand-mark">◧</span>
            <span>Slate</span>
        </div>

        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All">Plan</NavLink>
            <NavLink href="work-items">Work items</NavLink>
            @if (State.CanRecordTime)
            {
                <NavLink href="time">Time</NavLink>
            }
            <NavLink href="settings">Settings</NavLink>
            <NavLink href="help">Help</NavLink>
        </nav>

        <div class="topbar-spacer"></div>

        @* The mode switch: Basic lists and plans, Advanced writes back to Azure DevOps. *@
        <label class="switch mode-switch" title="@ModeTooltip">
            <input type="checkbox" checked="@State.IsAdvanced" @onchange="OnModeToggled" />
            <span class="track"></span>
            <span class="label">@(State.IsAdvanced ? "Advanced" : "Basic")</span>
        </label>

        @if (!State.Settings.IsAdoConfigured)
        {
            <button class="chip" @onclick="@(() => Nav.NavigateTo("settings"))" title="Connect to Azure DevOps to get started">
                <span class="dot" style="background: var(--warn)"></span>
                Setup needed
            </button>
        }
        else if (State.Outlook == OutlookState.NeedsSignIn)
        {
            <button class="chip" @onclick="@(() => Nav.NavigateTo("settings"))" title="Sign in to reach your Outlook calendar">
                <span class="dot" style="background: var(--warn)"></span>
                Not signed in
            </button>
        }
        else if (State.Outlook == OutlookState.Ready)
        {
            <span class="chip static truncate" style="max-width: 220px" title="@State.SignIn.Username">
                <span class="dot" style="background: var(--ok)"></span>
                @State.SignIn.Username
            </span>
        }

        @* With automatic sync on this is a status, not a control - until something needs
           attention, at which point it becomes the way to try again. *@
        @if (State.ShowOutlook)
        {
            @if (State.AutoSyncOn)
            {
                <button class="chip sync-status @SyncClass"
                        disabled="@(State.IsSyncing || !State.CanUseOutlook)"
                        @onclick="State.SyncAsync"
                        title="@SyncTooltip">
                    @if (State.IsSyncing)
                    {
                        <span class="spinner"></span>
                        <span>Updating Outlook…</span>
                    }
                    else if (State.AutoSyncFailed)
                    {
                        <span class="dot" style="background: var(--danger)"></span>
                        <span>Retry</span>
                    }
                    else if (Planner.PendingCount > 0)
                    {
                        <span class="dot" style="background: var(--warn)"></span>
                        <span>@Planner.PendingCount to send</span>
                    }
                    else
                    {
                        <span class="dot" style="background: var(--ok)"></span>
                        <span>In Outlook</span>
                    }
                </button>
            }
            else
            {
                <button class="btn btn-primary"
                        disabled="@(State.IsSyncing || Planner.PendingCount == 0 || !State.CanUseOutlook)"
                        @onclick="State.SyncAsync"
                        title="@(State.CanUseOutlook
                            ? "Create or update the Outlook events for every pending change"
                            : "Sign in on the Settings page first")">
                    @if (State.IsSyncing)
                    {
                        <span class="spinner on-accent"></span>
                        <span>Syncing…</span>
                    }
                    else
                    {
                        <span>↗</span>
                        <span>Send to Outlook</span>
                        @if (Planner.PendingCount > 0)
                        {
                            <span class="badge" style="background: rgba(255,255,255,.22); color: #fff">@Planner.PendingCount</span>
                        }
                    }
                </button>
            }
        }

        <button class="btn btn-icon btn-ghost" @onclick="ToggleThemeAsync" title="@ThemeTooltip">
            @ThemeGlyph
        </button>
    </header>

    <main class="content">
        @Body
    </main>
</div>

@* Once files start moving this copy has to stand still: the new copy reads the plan as it
   starts, and an edit made here after that would never reach it. *@
@if (IsInstalling)
{
    <div class="modal-scrim handover" role="alertdialog" aria-labelledby="handover-title">
        <div class="modal narrow">
            <div class="modal-body handover-body">
                <span class="boot-spinner"></span>
                <h2 id="handover-title">Installing Slate @Updates.Available?.Version</h2>
                <p class="muted">
                    Anything already on its way to Azure DevOps, Outlook or your plan finishes
                    first. Slate will restart by itself.
                </p>
            </div>
        </div>
    </div>
}

<Toasts />

@code {
    private string ThemeGlyph => Settings.Current.Ui.Theme switch
    {
        ThemeMode.Dark => "☾",
        ThemeMode.Light => "☀",
        _ => "◐",
    };

    private string ThemeTooltip => $"Theme: {Settings.Current.Ui.Theme}. Click to change.";

    private string SyncClass =>
        State.AutoSyncFailed ? "failed" : Planner.PendingCount > 0 ? "pending" : "ok";

    private string SyncTooltip =>
        !State.CanUseOutlook ? "Sign in on the Settings page to reach your calendar"
        : State.AutoSyncFailed ? "Something did not reach Outlook. Click to try again."
        : Planner.PendingCount > 0 ? $"{Planner.PendingCount} change(s) about to go to Outlook. Click to send them now."
        : "Every block matches your Outlook calendar.";

    private string ModeTooltip => State.IsAdvanced
        ? "Advanced: recording time, raising work items, editing and discussion are all available."
        : "Basic: list work items and plan your time against them. Nothing is written back to Azure DevOps.";

    /// <summary>
    /// Leaving Basic mode standing on a page it no longer offers would show an empty shell,
    /// so anything now hidden hands back to the plan.
    /// </summary>
    private void OnModeToggled(ChangeEventArgs e)
    {
        State.SetMode(e.Value is true ? AppMode.Advanced : AppMode.Basic);

        if (!State.CanRecordTime && Nav.Uri.Contains("/time", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("");
    }

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Planner.Changed += OnStateChanged;
        Toasts.Changed += OnStateChanged;
        Settings.Changed += OnSettingsChanged;
        Updates.Changed += OnStateChanged;
        Updater.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // First, because the copy this one replaced is waiting on it before it exits.
        if (SelfUpdater.TakeUpdatedFrom() is { } previous)
            Toasts.Success($"Updated to {AppInfo.Version}", $"Slate was on {previous}. Settings and the plan carried over.");

        await ApplyThemeAsync();
        await State.RefreshSignInAsync();

        // Not awaited yet: at launch this may spend a while quietly retrying a network that
        // is still coming up, and the calendar should not have to wait for it.
        var workItems = Task.CompletedTask;
        if (State.Settings.IsAdoConfigured)
            workItems = State.LoadWorkItemsAsync(atStartup: true);
        else
            Nav.NavigateTo("settings");

        if (State.ShowOutlook) await State.LoadEventsAsync();
        State.ConfigurePolling();
        await workItems;

        // Last, and not awaited: whether there is a newer build is the least urgent thing
        // on screen, and a slow or unreachable GitHub must not hold up the first paint.
        _ = Updates.CheckAsync();
    }

    private Task OpenReleaseAsync()
    {
        SystemShell.OpenUrl(Updates.Available?.Url);
        return Task.CompletedTask;
    }

    private string UpdateStatus(ReleaseInfo release) => Updater.Phase switch
    {
        UpdatePhase.Downloading when Updater.Total > 0 =>
            $"Downloading Slate {release.Version}… {Updater.Percent}% ({Megabytes(Updater.Received)} of {Megabytes(Updater.Total)} MB)",
        UpdatePhase.Downloading => $"Downloading Slate {release.Version}… {Megabytes(Updater.Received)} MB",
        UpdatePhase.Verifying => "Checking the download against GitHub's checksum…",
        _ => $"Installing Slate {release.Version} and restarting…",
    };

    private static string Megabytes(long bytes) => (bytes / 1048576d).ToString("0.0");

    private bool IsInstalling => Updater.Phase == UpdatePhase.Installing;

    /// <summary>
    /// Long enough for a sync of a busy week or a slow booking to finish. Anything still going
    /// after this is more likely stuck, and the update is abandoned rather than cutting it off.
    /// </summary>
    private static readonly TimeSpan HandoverWait = TimeSpan.FromSeconds(30);

    /// <summary>
    /// Anything that stops the install leaves this copy exactly as it was, so the fallback is
    /// the same as before in-app updates existed: the release page, to download it by hand.
    /// </summary>
    private async Task InstallUpdateAsync(ReleaseInfo release)
    {
        try
        {
            await Updater.InstallAsync(
                release,
                beforeSwap: () => State.PrepareForHandoverAsync(HandoverWait),
                // A rollback after the files have moved can happen on a thread this await is
                // no longer waiting on, so it undoes the standstill where it happens rather
                // than leaving it to the finally below.
                onRolledBack: State.ResumeAfterFailedHandover);
        }
        catch (UpdateInterruptedException ex)
        {
            // It says what stopped it and what that left behind; the wording below would throw
            // that away and leave the user guessing. The level goes by what it left rather than
            // by which exception came back: the old version going back is an aside, while the
            // same message can instead name an .exe to rename by hand, which is not. The
            // release page stays shut either way - this is a copy on its way out, and opening a
            // browser while Windows signs out is what the interruption exists to avoid.
            if (ex.NothingChanged) Toasts.Info("Update stopped", ex.Message);
            else Toasts.Error("Update stopped", ex.Message);
        }
        catch (OperationCanceledException)
        {
            Toasts.Info("Update cancelled", $"Still on {AppInfo.Version}.");
        }
        catch (SelfUpdateException ex)
        {
            // The reassurance only where it is true: a failure that left the new version in
            // place, or nothing at all, says so in its own message and must not be followed by
            // "nothing was changed".
            Toasts.Error(
                $"Could not install Slate {release.Version}",
                $"{ex.Message}{(ex.NothingChanged ? " Nothing was changed." : "")} " +
                "The release page is open so you can download it yourself.");
            SystemShell.OpenUrl(release.Url);
        }
        finally
        {
            // Whatever came back, including an exception none of the catches above name - the
            // renderer being torn down under the progress bar raises one - this copy must not
            // be left with every write, sync and timer refused for the rest of the session
            // behind a scrim that has gone. Not once it has handed over: there the standstill
            // is the whole point, and it holds until this copy exits.
            if (!SelfUpdater.IsHandingOver) State.ResumeAfterFailedHandover();
        }
    }

    private async Task ApplyThemeAsync()
    {
        var ui = Settings.Current.Ui;
        await Js.InvokeVoidAsync("planner.applyTheme", ui.Theme.ToString(), ui.Accent, ui.CompactDensity);
    }

    private async Task ToggleThemeAsync()
    {
        // Update rather than editing the live settings and saving them: while an update takes
        // over the save is refused, and Update refuses before anything has changed. Said out
        // loud when it is refused, rather than leaving the button looking like it missed.
        var saved = Settings.Update(settings => settings.Ui.Theme = settings.Ui.Theme switch
        {
            ThemeMode.Dark => ThemeMode.Light,
            ThemeMode.Light => ThemeMode.System,
            _ => ThemeMode.Dark,
        });

        if (!saved) Toasts.Error("Could not change the theme", AppState.RestartingForUpdate);
        await ApplyThemeAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnSettingsChanged() => InvokeAsync(async () =>
    {
        State.CheckConnection();
        await ApplyThemeAsync();
        State.ConfigurePolling();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Planner.Changed -= OnStateChanged;
        Toasts.Changed -= OnStateChanged;
        Settings.Changed -= OnSettingsChanged;
        Updates.Changed -= OnStateChanged;
        Updater.Changed -= OnStateChanged;
    }
}
