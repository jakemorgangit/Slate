@* Recorded-time marker. An inline SVG rather than an emoji so it actually takes the red. *@

<svg class="clock-icon" viewBox="0 0 16 16" width="@Size" height="@Size" role="img" aria-label="Time recorded">
    <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.7" />
    <path d="M8 4.3V8.2l2.6 1.6" fill="none" stroke="currentColor" stroke-width="1.7"
          stroke-linecap="round" stroke-linejoin="round" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 12;
}
