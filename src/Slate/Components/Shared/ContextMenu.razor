@* A right-click menu positioned at the pointer, kept whole and inside the window. *@

@inject IJSRuntime Js

@if (Visible)
{
    <div class="modal-scrim" style="background: transparent; backdrop-filter: none; padding: 0"
         @onclick="Close" @oncontextmenu="Close" @oncontextmenu:preventDefault="true">

        <div class="menu" @ref="_menu" style="@InitialPosition" @onclick:stopPropagation="true">
            @if (!string.IsNullOrWhiteSpace(Heading))
            {
                <div class="heading" title="@Heading">@Heading</div>
                <div class="sep"></div>
            }
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public string? Heading { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _menu;

    /// <summary>
    /// Where to draw it before it has been measured. Deliberately rough - it only has to
    /// avoid a visible jump; <c>planner.placeMenu</c> settles it against the real size.
    /// </summary>
    private string InitialPosition =>
        $"left: min({Round(X)}px, calc(100vw - 232px)); top: min({Round(Y)}px, calc(100vh - 120px));";

    private static string Round(double value) =>
        value.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// Positions against the menu as actually laid out. Its height and width depend on the
    /// work item behind it, so this cannot be worked out ahead of time - and a menu that
    /// runs off the window is one whose bottom entries cannot be reached at all.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible) return;

        try
        {
            await Js.InvokeVoidAsync("planner.placeMenu", _menu, X, Y);
        }
        catch (JSException)
        {
            // The menu closed between render and call. Its position no longer matters.
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
