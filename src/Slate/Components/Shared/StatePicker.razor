@using Slate.Services
@implements IDisposable

@inject AppState State

@*
    The work item's status: the state it is in as a single pill, and a dropdown to move it
    somewhere else. A pill per state read nicely with four of them and became a wall of
    colour on a process template that defines a dozen, so only the current one is coloured.
*@

<div class="state-control">
    @if (Option is { } current)
    {
        <span class="chip state-pill on" style="@Ui.StatePillStyle(current, true)" title="@StatusTitle">
            <span class="dot" style="background: @Ui.StateColour(current)"></span>
            <span>@current.Name</span>
        </span>
    }
    else if (!string.IsNullOrWhiteSpace(Current))
    {
        <span class="chip state-pill on" title="@StatusTitle">@Current</span>
    }

    @if (Moves.Count > 0)
    {
        @* Keyed on the current state: once it moves, the list of destinations changes under
           the dropdown, and without a fresh element the browser keeps whatever index was
           selected and shows a state nobody picked. *@
        <select @key="Current" class="select state-select" disabled="@Busy" @onchange="OnSelectedAsync"
                @onclick:stopPropagation="true" title="Move this work item to another state">
            <option value="">@(Busy ? "Saving…" : "Change to…")</option>
            @foreach (var option in Moves)
            {
                <option value="@option.Name">@option.Name</option>
            }
        </select>
    }
</div>

@code {
    [Parameter, EditorRequired] public int WorkItemId { get; set; }
    [Parameter, EditorRequired] public string Project { get; set; } = "";
    [Parameter, EditorRequired] public string WorkItemType { get; set; } = "";
    [Parameter, EditorRequired] public string Current { get; set; } = "";

    /// <summary>Raised after the state has actually been written.</summary>
    [Parameter] public EventCallback<string> OnChanged { get; set; }

    private IReadOnlyList<WorkItemStateOption> _states = [];

    private bool Busy => State.SavingStateFor == WorkItemId;

    /// <summary>The state the item is in, when the process template owns up to it.</summary>
    private WorkItemStateOption? Option =>
        _states.FirstOrDefault(s => string.Equals(s.Name, Current, StringComparison.OrdinalIgnoreCase));

    /// <summary>Everywhere it could go instead - so, everything but where it already is.</summary>
    private IReadOnlyList<WorkItemStateOption> Moves =>
        [.. _states.Where(s => !string.Equals(s.Name, Current, StringComparison.OrdinalIgnoreCase))];

    private string StatusTitle => $"This work item is {Current}";

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override async Task OnParametersSetAsync()
    {
        _states = State.KnownStates(Project, WorkItemType);
        if (_states.Count == 0) await State.EnsureStatesAsync(Project, WorkItemType);
    }

    private void OnStateChanged() => InvokeAsync(() =>
    {
        var latest = State.KnownStates(Project, WorkItemType);
        if (latest.Count != _states.Count) _states = latest;
        StateHasChanged();
    });

    public void Dispose() => State.Changed -= OnStateChanged;

    private async Task OnSelectedAsync(ChangeEventArgs e)
    {
        var picked = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(picked) || Busy) return;

        if (await State.SetStateAsync(WorkItemId, picked))
            await OnChanged.InvokeAsync(picked);
    }
}
