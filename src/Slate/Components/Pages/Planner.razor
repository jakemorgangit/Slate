    private void ToggleBusyOverlay()
    {
        var settings = Settings.Current;
        settings.Planning.ShowExistingEvents = !settings.Planning.ShowExistingEvents;

        // Now it is a decision made with the calendar in front of you, so it stands.
        settings.Planning.OverlayChosen = true;
        Settings.Save(settings);
        _ = State.LoadEventsAsync();
    }

    private void ToggleDensity()
    {
