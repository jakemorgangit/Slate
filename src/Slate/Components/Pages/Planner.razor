    /// <summary>Refuses a placement that would sit on top of an existing calendar entry.</summary>
    private bool Reject(DateTime start, DateTime end)
    {
        if (!State.BlocksPlacement(start, end)) return false;

        Toasts.Warning("That time is already taken",
            "Something is in your Outlook calendar there. Turn off \"Never plan over existing events\" in Settings to allow it.");
        return true;
    }

    /// <summary>Called by planner.js when a drag is released somewhere it cannot land.</summary>
    [JSInvokable]
    public void OnDropRejected()
    {
        Toasts.Warning("That time is already taken",
            "Pick a slot that is free, or allow overlaps in Settings.");
        InvokeAsync(StateHasChanged);
    }

    // ---------------------------------------------------------------- geometry

    private int OffsetPx(DateTime day, DateTime time)
    {
        var minutes = (time - (day.Date + DayStart)).TotalMinutes;
        return (int)Math.Round(Math.Max(0, minutes) / SlotMinutes * SlotPx);
    }

    private int SpanPx(DateTime day, DateTime start, DateTime end)
    {
        var dayOpen = day.Date + DayStart;
        var dayClose = day.Date + DayEnd;

        var from = start < dayOpen ? dayOpen : start;
        var to = end > dayClose ? dayClose : end;
        if (to <= from) return 0;

        return (int)Math.Round((to - from).TotalMinutes / SlotMinutes * SlotPx);
    }

