    private void DeleteAllocation(Guid id)
    {
        Plan.Remove(id);
        State.SelectAllocation(null);
        _inspectorOpen = false;
    }

    private async Task SendOneAsync(Guid id)
    {
        if (!State.Settings.IsCalendarConfigured)
        {
            Toasts.Error("Outlook is not connected", "Add your Entra ID client ID and sign in from Settings.");
            return;
        }

        if (await Plan.SyncOneAsync(id))
        {
            Toasts.Success("Sent to Outlook");
            await State.LoadEventsAsync();
        }
        else
        {
            Toasts.Error("Could not send that block", Plan.Find(id)?.LastError);
        }
    }

    private async Task StartResizeAsync(Allocation allocation, PointerEventArgs e)
    {
        State.SelectAllocation(allocation.Id);
        await Js.InvokeVoidAsync("planner.startResize", _self, allocation.Id.ToString(),
            e.ClientY, allocation.DurationMinutes, SlotPx, SlotMinutes);
    }

    [JSInvokable]
    public void OnResized(string allocationId, int minutes)
    {
        if (!Guid.TryParse(allocationId, out var id)) return;

        // Growing a block downwards can reach an existing calendar entry just as dropping one
        // can, so it is refused the same way rather than quietly booking over a meeting.
        var allocation = Plan.Find(id);
        if (allocation is not null && Reject(allocation.Start, allocation.Start.AddMinutes(minutes)))
        {
            InvokeAsync(StateHasChanged);
            return;
        }

        Plan.Resize(id, minutes);
    }

    [JSInvokable]
    public void OnResizeCancelled() => InvokeAsync(StateHasChanged);

