    private Task BookNextFree(WorkItem item) => State.ScheduleIntoNextFree(item);

    private void WarnIfConflict(Allocation allocation)
    {
        if (!State.HasConflict(allocation.Start, allocation.End)) return;
        Toasts.Warning("Overlaps something in Outlook",
            $"{Ui.RelativeDay(allocation.Start)} {Ui.TimeRange(allocation.Start, allocation.End)} already has an event.");
    }

