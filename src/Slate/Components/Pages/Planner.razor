    // ---------------------------------------------------------------- overlap layout

    private sealed record Placed(Allocation Allocation, int Lane, int Lanes);

    /// <summary>Packs overlapping blocks into side-by-side lanes, the way a calendar does.</summary>
    private static List<Placed> Layout(List<Allocation> allocations)
    {
        var result = new List<Placed>();
        var sorted = allocations.OrderBy(a => a.Start).ThenBy(a => a.DurationMinutes).ToList();

        var i = 0;
        while (i < sorted.Count)
        {
            // Collect one cluster of transitively overlapping blocks.
            var cluster = new List<Allocation> { sorted[i] };
            var clusterEnd = sorted[i].End;
            var j = i + 1;

            while (j < sorted.Count && sorted[j].Start < clusterEnd)
            {
                cluster.Add(sorted[j]);
                if (sorted[j].End > clusterEnd) clusterEnd = sorted[j].End;
                j++;
            }

            // Greedily place each block in the first lane that has come free.
            var laneEnds = new List<DateTime>();
            var lanes = new int[cluster.Count];

            for (var k = 0; k < cluster.Count; k++)
            {
                var lane = laneEnds.FindIndex(end => end <= cluster[k].Start);
                if (lane < 0)
                {
                    laneEnds.Add(cluster[k].End);
                    lane = laneEnds.Count - 1;
                }
                else
                {
                    laneEnds[lane] = cluster[k].End;
                }

                lanes[k] = lane;
            }

            for (var k = 0; k < cluster.Count; k++)
                result.Add(new Placed(cluster[k], lanes[k], laneEnds.Count));

            i = j;
        }

        return result;
    }
