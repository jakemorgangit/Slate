    /// <summary>
    /// Called by planner.js when a drag is released over a slot. Ctrl held means copy rather
    /// than move, which is the usual calendar convention.
    /// </summary>
    [JSInvokable]
    public void OnPointerDrop(string kind, string id, string day, int slotIndex, bool copy)
    {
        if (!DateTime.TryParseExact(day, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var date))
            return;

        if (slotIndex < 0 || slotIndex >= SlotCount) return;
        var start = SlotStart(date, slotIndex);

        if (kind == "workitem" && int.TryParse(id, out var workItemId))
        {
            var item = State.WorkItems.FirstOrDefault(i => i.Id == workItemId);
            if (item is null) return;

            var minutes = Plan.SuggestedDuration(item);
            if (Reject(start, start.AddMinutes(minutes))) return;

            var allocation = Plan.Add(item, start, minutes);
            State.SelectAllocation(allocation.Id);
            WarnIfConflict(allocation);
            State.OfferTaskIfUntrackable(allocation);
        }
        else if (kind == "allocation" && Guid.TryParse(id, out var allocationId))
        {
            if (Plan.Find(allocationId) is not { } existing) return;
            if (Reject(start, start.AddMinutes(existing.DurationMinutes))) return;

            if (copy)
            {
                var duplicate = Plan.Duplicate(allocationId, start);
                if (duplicate is null) return;
                State.SelectAllocation(duplicate.Id);
                WarnIfConflict(duplicate);
            }
            else
            {
                Plan.Move(allocationId, start);
                State.SelectAllocation(allocationId);
                if (Plan.Find(allocationId) is { } moved) WarnIfConflict(moved);
            }
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>Opens the schedule dialog: next free gap, or a time of your choosing.</summary>
    private void ScheduleNextFree(WorkItem item) => State.BeginSchedule(item);

