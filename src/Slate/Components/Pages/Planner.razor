        settings.Ui.CompactDensity = !settings.Ui.CompactDensity;
        Settings.Save(settings);
    }

    private void ClearWeek()
    {
        var count = Plan.InRange(State.WeekStart, State.WeekStart.AddDays(7)).Count();
        Plan.ClearRange(State.WeekStart, State.WeekStart.AddDays(7));
        State.SelectAllocation(null);
        Toasts.Info($"Cleared {count} block(s)",
            State.ShowOutlook ? "Press Send to Outlook to remove the matching events." : "");
    }

    // ---------------------------------------------------------------- shortcuts

    [JSInvokable]
    public async Task OnShortcut(string combo)
    {
        switch (combo)
        {
            case "arrowleft": State.GoToWeek(-1); break;
            case "arrowright": State.GoToWeek(1); break;
            case "t": State.GoToToday(); break;
            case "r": await State.LoadWorkItemsAsync(showToast: true); break;
            case "ctrl+s": if (State.CanUseOutlook) await State.SyncAsync(); break;
            case "delete":
                if (State.SelectedAllocationId is Guid id) DeleteAllocation(id);
                break;
            case "escape":
                CloseMenu();
                State.CloseWorkItem();
                State.CancelRecordTime();
                State.CancelSchedule();
                State.SelectAllocation(null);
                _inspectorOpen = false;
                break;
            case "f":
            case "/":
            case "ctrl+f":
                await Js.InvokeVoidAsync("planner.focusSelector", "#wi-search");
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

