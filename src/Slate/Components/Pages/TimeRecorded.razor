@page "/time"
@using Slate.Services
@implements IDisposable

@inject AppState State
@inject PlannerService Plan
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Time recorded</PageTitle>

@* Reachable by URL as well as by the tab, so the route guards itself. *@
@if (!State.CanRecordTime)
{
    <div class="page">
        <div class="empty-state">
            <span class="glyph">◔</span>
            <h2>Time recording is an Advanced feature</h2>
            <p>Switch the toggle in the header to Advanced to record time against work items.</p>
            <button class="btn" style="margin-top: 10px" @onclick="@(() => Nav.NavigateTo(""))">Back to the plan</button>
        </div>
    </div>
    return;
}

<div class="page">
    <div class="page-head">
        <div>
            <h1>Time recorded</h1>
            <p>Everything booked against Azure DevOps from your calendar blocks.</p>
        </div>
        <div class="spacer"></div>

        <div class="btn-group">
            <button class="btn btn-icon" title="Previous week" @onclick="() => State.GoToWeek(-1)">‹</button>
            <button class="btn" title="Jump to this week" @onclick="State.GoToToday">This week</button>
            <button class="btn btn-icon" title="Next week" @onclick="() => State.GoToWeek(1)">›</button>
        </div>

        <div>
            <div class="cal-range">@WeekLabel</div>
            <div class="cal-sub">@Ui.Hours(WeekMinutes) recorded across @_entries.Count entr@(_entries.Count == 1 ? "y" : "ies")</div>
        </div>
    </div>

    @* Bookings Azure DevOps never confirmed. Shown here whatever week is on screen, and
       whether or not their block still exists: one from a block deleted since cannot be
       reached from the plan at all, and without somewhere like this it would sit in the
       file for ever with no way to settle it. *@
    @if (_unsettled.Count > 0)
    {
        <div class="card">
            <div class="card-head">
                <div class="grow">
                    <h2>Not confirmed by Azure DevOps</h2>
                    <div class="sub">
                        Sent, with no answer either way. They count towards nothing above until one of them is settled.
                    </div>
                </div>
            </div>
            <div class="card-body">
                @foreach (var block in _unsettled)
                {
                    <div class="banner error" @key="block.AllocationId">
                        <span>!</span>
                        <div class="grow">
                            <div>
                                <strong>@Ui.Hours(block.Minutes)</strong> for
                                <span class="mono">#@block.First.WorkItemId</span>
                                <span>@Ui.Clip(block.First.WorkItemTitle, NoteLimit)</span>,
                                sent @Ui.Ago(block.First.RecordedAt).
                                @if (Plan.Find(block.AllocationId) is null)
                                {
                                    <span class="badge badge-muted" title="The calendar block it came from has gone">Block deleted</span>
                                }
                            </div>
                            @* Booked against an organization Slate is not connected to now.
                               Nothing here can be settled against it - #7 over here is a
                               different work item - and a renamed or moved organization has no
                               old address left to switch back to, so the only way out is the
                               user saying it is the same one. Said of the bookings it is true
                               of: a block can hold one from either side of a switch. *@
                            @if (block.Elsewhere is { } where)
                            {
                                <div>
                                    @(block.AllElsewhere ? "It was booked" : "Part of it was booked")
                                    against <span class="mono">@where</span>, which Slate is not
                                    connected to now, so nothing here can settle
                                    @(block.AllElsewhere ? "it" : "that part").
                                </div>
                            }
                            @if (!block.AllElsewhere)
                            {
                                <div>It may already be on the work item - look there before recording those hours again.</div>
                            }
                            <div class="row" style="margin-top: 8px; gap: 6px">
                                @if (!block.AllElsewhere)
                                {
                                    <button class="btn btn-sm" disabled="@(_busy is not null)"
                                            @onclick="() => CheckAsync(block)">
                                        @if (_busy == block.AllocationId)
                                        {
                                            <span class="spinner"></span>
                                            <span>Checking…</span>
                                        }
                                        else
                                        {
                                            <span>Check</span>
                                        }
                                    </button>
                                }
                                @if (block.First.WorkItemUrl is { Length: > 0 } url)
                                {
                                    <button class="btn btn-sm btn-ghost" title="Open the work item in Azure DevOps"
                                            @onclick="() => SystemShell.OpenUrl(url)">Open #@block.First.WorkItemId ↗</button>
                                }
                                @if (block.Elsewhere is not null)
                                {
                                    <button class="btn btn-sm btn-ghost" disabled="@(_busy is not null)"
                                            title="Only if that address and this one are the same organization - renamed, moved to dev.azure.com, or reached by a new server name. Nothing is written to Azure DevOps; the booking simply becomes one this connection can check and answer for."
                                            @onclick="() => Adopt(block)">Same organization - settle it here</button>
                                }
                                @if (block.CanBeLetGo)
                                {
                                    <button class="btn btn-sm btn-ghost" disabled="@(_busy is not null)"
                                            title="Only once you have looked at the work item and these hours are on it. Nothing is written to Azure DevOps; the booking is simply recorded here as it stands."
                                            @onclick="() => FileIt(block)">It did go on</button>
                                    <button class="btn btn-sm btn-ghost" disabled="@(_busy is not null)"
                                            title="Only once you have looked at the work item and these hours are not on it. Nothing is written to Azure DevOps; Slate simply stops waiting."
                                            @onclick="() => LetGo(block)">Never went on</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Undos Azure DevOps never confirmed, for entries booked in some other week. An entry
       showing this week is answered from its own row further down; one from three weeks ago
       has no row here at all, and until its undo is answered that entry can never be undone.
       That makes it outstanding in exactly the same sense as the bookings above, so like them
       it is shown whatever week is on screen rather than only on its own. *@
    @if (_stuckUndos.Count > 0)
    {
        <div class="card">
            <div class="card-head">
                <div class="grow">
                    <h2>Undos not confirmed, from other weeks</h2>
                    <div class="sub">
                        Sent, with no answer either way. Until one is answered, its entry cannot be undone.
                    </div>
                </div>
            </div>
            <div class="card-body">
                @foreach (var (entry, undo) in _stuckUndos)
                {
                    <div class="banner error" @key="entry.Id">
                        <span>!</span>
                        <div class="grow">
                            <div>
                                <strong>@Ui.DecimalHours(entry.Minutes)h</strong> for
                                <span class="mono">#@entry.WorkItemId</span>
                                <span>@Ui.Clip(entry.WorkItemTitle, NoteLimit)</span>,
                                booked @entry.Date.ToString("d MMM yyyy").
                            </div>
                            <div>
                                Azure DevOps never confirmed the undo sent @Ui.Ago(undo.SentAt),
                                so those hours may or may not still be on the work item.
                            </div>
                            @if (!entry.BelongsTo(_organization))
                            {
                                <div>
                                    It was booked against <span class="mono">@AppState.BookedAgainst(entry)</span>, which Slate is
                                    not connected to now, so nothing here can settle it.
                                </div>
                            }
                            <div class="row" style="margin-top: 8px; gap: 6px">
                                @if (entry.WorkItemUrl is { Length: > 0 } undoneUrl)
                                {
                                    <button class="btn btn-sm btn-ghost" title="Open the work item in Azure DevOps"
                                            @onclick="() => SystemShell.OpenUrl(undoneUrl)">Open #@entry.WorkItemId ↗</button>
                                }
                                @if (!entry.BelongsTo(_organization))
                                {
                                    <button class="btn btn-sm btn-ghost" disabled="@(_undoing is not null)"
                                            title="Only if that address and this one are the same organization - renamed, moved to dev.azure.com, or reached by a new server name. Nothing is written to Azure DevOps."
                                            @onclick="() => AdoptEntry(entry)">Same organization</button>
                                }
                                else if (!undo.CouldStillLand)
                                {
                                    <button class="btn btn-sm btn-ghost" disabled="@(_undoing is not null)"
                                            title="Only once you have looked at the work item and those hours are no longer on it. Nothing is written to Azure DevOps; the entry is simply dropped, as the undo would have."
                                            @onclick="() => AnswerUndo(entry, wentThrough: true)">The undo did go through</button>
                                    <button class="btn btn-sm btn-ghost" disabled="@(_undoing is not null)"
                                            title="Only once you have looked at the work item and those hours are still on it. Nothing is written to Azure DevOps; the entry stands and Undo works on it again."
                                            @onclick="() => AnswerUndo(entry, wentThrough: false)">It never went through</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_entries.Count == 0)
    {
        <div class="empty-state">
            <span class="glyph"><ClockIcon Size="34" /></span>
            <h2>No time recorded this week</h2>
            <p>
                Right-click a block on the Plan tab and choose <strong>Record time…</strong>.
                Entries you book show up here, and on the work item in Azure DevOps.
            </p>
        </div>
    }
    else
    {
        @* ------------------------------------------------ timesheet grid *@
        <div class="card">
            <div class="card-head">
                <div class="grow">
                    <h2>Week summary</h2>
                    <div class="sub">Hours per work item per day, the way a timesheet reads.</div>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data timesheet">
                    <thead>
                        <tr>
                            <th class="sticky-col">Work item</th>
                            @foreach (var day in _days)
                            {
                                <th class="cell-num @(day.Date == DateTime.Today ? "today" : "")">
                                    <div class="dow">@day.ToString("ddd")</div>
                                    <div class="dom">@day.Day</div>
                                </th>
                            }
                            <th class="cell-num total-col">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr @key="row.WorkItemId">
                                <td class="sticky-col">
                                    <button class="link-cell" title="Open this work item"
                                            @onclick="() => State.ShowWorkItemAsync(row.WorkItemId)">
                                        <span class="dot" style="background: @Ui.ColorFor(row.WorkItemType)"></span>
                                        <span class="mono muted">#@row.WorkItemId</span>
                                        <span class="truncate">@row.Title</span>
                                    </button>
                                </td>
                                @foreach (var day in _days)
                                {
                                    var minutes = row.MinutesOn(day);
                                    <td class="cell-num @(minutes > 0 ? "has-time" : "")">
                                        @(minutes > 0 ? Ui.DecimalHours(minutes) : "")
                                    </td>
                                }
                                <td class="cell-num total-col">@Ui.DecimalHours(row.TotalMinutes)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="sticky-col"><strong>Daily total</strong></td>
                            @foreach (var day in _days)
                            {
                                var minutes = MinutesOn(day);
                                <td class="cell-num @(minutes > 0 ? "has-time" : "")">
                                    <strong>@(minutes > 0 ? Ui.DecimalHours(minutes) : "—")</strong>
                                </td>
                            }
                            <td class="cell-num total-col"><strong>@Ui.DecimalHours(WeekMinutes)</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @* ------------------------------------------------ ghost entries *@
        <div class="card">
            <div class="card-head">
                <div class="grow">
                    <h2>Entries</h2>
                    <div class="sub">Each one mirrors the calendar block it came from.</div>
                </div>
            </div>
            <div class="card-body">
                @foreach (var day in _days.Where(d => MinutesOn(d) > 0))
                {
                    <div class="entry-day" @key="day.Ticks">
                        <div class="entry-day-head">
                            <span class="@(day.Date == DateTime.Today ? "today" : "")">@day.ToString("dddd d MMMM")</span>
                            <span class="topbar-spacer"></span>
                            <span class="muted">@Ui.Hours(MinutesOn(day))</span>
                        </div>

                        @foreach (var entry in _entries.Where(e => e.Date.Date == day.Date))
                        {
                            var live = Plan.Find(entry.AllocationId) is not null;
                            <div class="ghost-entry" @key="entry.Id" style="--wi-color: @Ui.ColorFor(entry.WorkItemType)">
                                <div class="ghost-time">
                                    <div class="range">@Ui.TimeRange(entry.Start, entry.End)</div>
                                    <div class="muted">@Ui.Duration(entry.BlockMinutes) block</div>
                                </div>

                                <div class="grow">
                                    <button class="link-cell" title="Open this work item"
                                            @onclick="() => State.ShowWorkItemAsync(entry.WorkItemId)">
                                        <span class="mono muted">#@entry.WorkItemId</span>
                                        <span class="truncate">@entry.WorkItemTitle</span>
                                    </button>
                                    <div class="ghost-meta">
                                        <span>@entry.WorkItemType</span>
                                        <span>·</span>
                                        <span>recorded @Ui.Ago(entry.RecordedAt)</span>
                                        @if (!entry.ReducedRemaining)
                                        {
                                            <span class="badge badge-muted">Remaining untouched</span>
                                        }
                                        @if (!live)
                                        {
                                            <span class="badge badge-muted" title="The calendar block it came from has gone">Block deleted</span>
                                        }
                                        @if (entry.UnconfirmedUndo is not null)
                                        {
                                            <span class="badge badge-danger"
                                                  title="An undo of these hours went to Azure DevOps and was never confirmed. Undo looks for it first, so nothing is ever taken off twice.">Undo not confirmed</span>
                                        }
                                    </div>

                                    @* An undo that nothing can settle leaves the entry
                                       un-undoable: every Undo of it stops at the same
                                       unanswerable question. The work item itself can answer
                                       it, so the two answers are offered here - once no send
                                       of that undo could still be arriving, which is the same
                                       window a booking's answers wait for. An entry booked in
                                       another week has no row here at all; those are gathered
                                       into their own section at the top of the page.

                                       Gated on the organization as well, the way that section
                                       is: both answers rest on the user having looked at the
                                       work item, and hours booked against an address Slate is
                                       not connected to are the one case where they cannot
                                       have. "Same organization", just below, is the way out
                                       for those. *@
                                    @if (entry.UnconfirmedUndo is { } undo)
                                    {
                                        <div style="margin-top: 4px; font-size: 11.5px; color: var(--danger)">
                                            Azure DevOps never confirmed the undo sent @Ui.Ago(undo.SentAt),
                                            so those hours may or may not still be on the work item.
                                        </div>
                                        @if (!undo.CouldStillLand && entry.BelongsTo(_organization))
                                        {
                                            <div class="row" style="margin-top: 6px; gap: 6px">
                                                <button class="btn btn-sm btn-ghost" disabled="@(_undoing is not null)"
                                                        title="Only once you have looked at the work item and those hours are no longer on it. Nothing is written to Azure DevOps; the entry is simply dropped, as the undo would have."
                                                        @onclick="() => AnswerUndo(entry, wentThrough: true)">The undo did go through</button>
                                                <button class="btn btn-sm btn-ghost" disabled="@(_undoing is not null)"
                                                        title="Only once you have looked at the work item and those hours are still on it. Nothing is written to Azure DevOps; the entry stands and Undo works on it again."
                                                        @onclick="() => AnswerUndo(entry, wentThrough: false)">It never went through</button>
                                            </div>
                                        }
                                    }

                                    @* Hours booked against an address this connection is not
                                       at cannot be undone from here: #7 over here is a
                                       different work item. Recoverable rather than a dead end,
                                       because an organization that was renamed or moved has no
                                       old address left to switch back to. *@
                                    @if (!entry.BelongsTo(_organization))
                                    {
                                        <div style="margin-top: 4px; font-size: 11.5px; color: var(--text-3)">
                                            Booked against <span class="mono">@AppState.BookedAgainst(entry)</span>, which Slate is
                                            not connected to now, so Undo would change a different work item.
                                            <button class="btn btn-sm btn-ghost" style="margin-left: 6px"
                                                    disabled="@(_undoing is not null)"
                                                    title="Only if that address and this one are the same organization - renamed, moved to dev.azure.com, or reached by a new server name. Nothing is written to Azure DevOps."
                                                    @onclick="() => AdoptEntry(entry)">Same organization</button>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                    {
                                        @* Held to a readable length; the whole of it is on hover. *@
                                        <div class="ghost-note" title="@entry.Comment">
                                            <span class="quote-mark">“</span>
                                            <span class="truncate">@Ui.Clip(entry.Comment, NoteLimit)</span>
                                        </div>
                                    }
                                </div>

                                @* Pinned to the right edge, so the hours and Undo line up down
                                   the column however long the title or the note happens to be. *@
                                <div class="ghost-actions">
                                    <div class="ghost-hours">
                                        <ClockIcon Size="12" />
                                        <span>@Ui.DecimalHours(entry.Minutes)h</span>
                                    </div>

                                    <button class="btn btn-sm btn-danger" title="Take this time back off the work item"
                                            disabled="@(_undoing == entry.Id)"
                                            @onclick="() => UndoAsync(entry)">
                                        @if (_undoing == entry.Id)
                                        {
                                            <span class="spinner"></span>
                                        }
                                        <span>Undo</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<WorkItemModal />
<PriorityDialog />

@code {
    private List<TimeEntry> _entries = [];
    private List<DateTime> _days = [];
    private List<Row> _rows = [];
    private List<AppState.UnsettledBlock> _unsettled = [];
    /// <summary>
    /// Entries whose undo Azure DevOps never confirmed, from weeks other than the one on
    /// screen. The pin is taken here rather than read again while rendering: the quiet settle
    /// runs on its own thread and can answer one of these in between, and a row that read the
    /// pin a second time would find it gone.
    /// </summary>
    private List<(TimeEntry Entry, TimeWritePlan Undo)> _stuckUndos = [];
    private Guid? _undoing;
    private Guid? _busy;

    /// <summary>The organization Slate is connected to, as of the last rebuild of this page.</summary>
    private OrganizationRef _organization = OrganizationRef.None;

    /// <summary>How much of a note the row shows before the rest is left to the tooltip.</summary>
    private const int NoteLimit = 110;

    /// <summary>One work item's week: its per-day totals.</summary>
    private sealed record Row(int WorkItemId, string Title, string WorkItemType, Dictionary<DateTime, int> ByDay)
    {
        public int MinutesOn(DateTime day) => ByDay.GetValueOrDefault(day.Date);
        public int TotalMinutes => ByDay.Values.Sum();
    }

    private string WeekLabel
    {
        get
        {
            var start = State.WeekStart;
            var end = start.AddDays(6);
            var prefix = State.IsCurrentWeek ? "This week · " : "";
            return start.Month == end.Month
                ? $"{prefix}{start:d} – {end:d MMM yyyy}"
                : $"{prefix}{start:d MMM} – {end:d MMM yyyy}";
        }
    }

    private int WeekMinutes => _entries.Sum(e => e.Minutes);

    private int MinutesOn(DateTime day) =>
        _entries.Where(e => e.Date.Date == day.Date).Sum(e => e.Minutes);

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Plan.Changed += OnChanged;
        Recompute();
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        Recompute();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Plan.Changed -= OnChanged;
    }

    private void Recompute()
    {
        // The whole week, not just working days - time can land on a Saturday.
        _days = [.. Enumerable.Range(0, 7).Select(i => State.WeekStart.AddDays(i))];
        _entries = [.. Plan.EntriesInRange(State.WeekStart, State.WeekStart.AddDays(7))];

        _rows = [.. _entries
            .GroupBy(e => e.WorkItemId)
            .Select(g => new Row(
                g.Key,
                g.First().WorkItemTitle,
                g.First().WorkItemType,
                g.GroupBy(e => e.Date.Date).ToDictionary(d => d.Key, d => d.Sum(e => e.Minutes))))
            .OrderByDescending(r => r.TotalMinutes)
            .ThenBy(r => r.WorkItemId)];

        // Worked out once for the whole page: normalising an organization address for every
        // row of every render is work nobody asked for.
        _organization = State.CurrentOrganization;

        // Not filtered to the week on screen: these are outstanding, not history, and the one
        // whose block was deleted has nowhere else at all to be settled from.
        _unsettled = [.. Plan.UnconfirmedBookings
            .GroupBy(b => b.Entry.AllocationId)
            .Select(g => State.Split(g.Key, [.. g.OrderBy(b => b.Entry.RecordedAt)]))
            .OrderBy(u => u.First.RecordedAt)];

        // An entry whose undo is stuck is outstanding in the same sense, and it cannot be
        // undone until that undo is answered. The ones this week is showing are answered from
        // their own rows; the rest have no row here, so they are collected above.
        var weekEnd = State.WeekStart.AddDays(7);
        _stuckUndos = [];

        foreach (var entry in Plan.TimeEntries.OrderBy(e => e.Date).ThenBy(e => e.Start))
        {
            if (entry.Date.Date >= State.WeekStart.Date && entry.Date.Date < weekEnd.Date) continue;
            if (entry.UnconfirmedUndo is { } undo) _stuckUndos.Add((entry, undo));
        }
    }

    /// <summary>
    /// Looks at the work item for one block's unconfirmed bookings, without writing anything.
    /// The list rebuilds itself from the plan afterwards, so whatever it settled simply drops
    /// off - filed above as an entry, or let go.
    /// </summary>
    private async Task CheckAsync(AppState.UnsettledBlock block)
    {
        if (_busy is not null) return;

        _busy = block.AllocationId;
        try
        {
            await State.CheckUnconfirmedAsync(block.AllocationId);
        }
        finally
        {
            _busy = null;
            Recompute();
        }
    }

    /// <summary>Stops waiting on bookings the user has checked and found are not on the item.</summary>
    private void LetGo(AppState.UnsettledBlock block)
    {
        if (_busy is not null) return;

        State.LetGoUnconfirmed(block.AllocationId);
        Recompute();
    }

    /// <summary>
    /// Files bookings the user has checked and found are on the item. Offered here as well as
    /// in the two dialogs because a booking whose block has been deleted has nowhere else to
    /// be answered at all, and "never went on" is the wrong answer for it.
    /// </summary>
    private void FileIt(AppState.UnsettledBlock block)
    {
        if (_busy is not null) return;

        State.FileUnconfirmed(block.AllocationId);
        Recompute();
    }

    /// <summary>Takes a block's bookings as this organization's, when the user says they are.</summary>
    private void Adopt(AppState.UnsettledBlock block)
    {
        if (_busy is not null) return;

        State.AdoptOrganizationForBlock(block.AllocationId);
        Recompute();
    }

    /// <summary>The same for one filed entry, so its Undo stops being refused.</summary>
    private void AdoptEntry(TimeEntry entry)
    {
        if (_undoing is not null) return;

        State.AdoptOrganizationForEntry(entry.Id);
        Recompute();
    }

    /// <summary>
    /// Answers for an undo Azure DevOps never confirmed, from what the work item itself says.
    /// The entry goes if it went through, and stands if it did not; nothing is sent either way.
    /// </summary>
    private void AnswerUndo(TimeEntry entry, bool wentThrough)
    {
        if (_undoing is not null) return;

        State.AnswerUnconfirmedUndo(entry.Id, wentThrough);
        Recompute();
    }

    private async Task UndoAsync(TimeEntry entry)
    {
        if (_undoing is not null) return;

        _undoing = entry.Id;
        try
        {
            await State.UndoTimeEntryAsync(entry);
        }
        finally
        {
            _undoing = null;
        }
    }
}
